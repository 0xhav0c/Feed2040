# ╔═══════════════════════════════════════════════════════╗
# ║            Feed2040 Configuration                    ║
# ╚═══════════════════════════════════════════════════════╝
# Copy this file to .env and fill in the values.
# Only NEXTAUTH_SECRET is required to change for production.

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=feed2040
POSTGRES_PASSWORD=feed2040
POSTGRES_DB=feed2040

# ── Application ───────────────────────────────────────────
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
# REQUIRED: Generate a secure secret with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Feed Refresh ──────────────────────────────────────────
REFRESH_INTERVAL_MINUTES=15

# REQUIRED: Generate a strong secret with:
#   openssl rand -hex 24
CRON_SECRET=

# ── AI & Telegram ─────────────────────────────────────────
# Configured in the app: Settings → AI provider / Notifications.
